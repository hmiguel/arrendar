---
import type { Stage } from '../data/stages';
import type { UiStrings } from '../i18n/strings';

interface Props {
  stage: Stage;
  open?: boolean;
  total: number;
  strings: UiStrings;
}

const { stage, open = false, total, strings } = Astro.props;
const padded = String(stage.number).padStart(2, '0');
---

<details class="stage" open={open}>
  <summary class="stage__summary">
    <span class="stage__num" aria-hidden="true">{padded}</span>
    <span class="stage__headline">
      <h2><span class="sr-only">{strings.stageSrLabel(stage.number, total)}</span>{stage.title}</h2>
      <span class="stage__subtitle">{stage.subtitle}</span>
    </span>
    <span class="stage__toggle" aria-hidden="true"></span>
  </summary>

  <div class="stage__body">
    {
      stage.highlights.map((h) => (
        <details class="highlight">
          <summary class="highlight__summary">
            <span class="highlight__mark" aria-hidden="true" />
            <span>{h.text}</span>
          </summary>
          <div class="highlight__detail">
            <h3>{h.detail.title}</h3>
            {h.detail.paragraphs.map((p) => <p>{p}</p>)}
            {h.detail.pending && (
              <div class="pending">
                <span class="pending__label">{strings.pendingLabel}</span>
                <p>{h.detail.pending}</p>
              </div>
            )}
            <div class="refs">
              {h.detail.refs.map((r) => (
                <details class="ref">
                  <summary class="ref__summary">{r.label}</summary>
                  <div class="ref__text">
                    {r.quote &&
                      r.quote.split('\n').map((line) => <p class="ref__quote">{line}</p>)}
                    {r.quoteTranslation && (
                      <div class="ref__translation">
                        <span class="ref__translation-label">{strings.unofficialTranslationLabel}</span>
                        {r.quoteTranslation.split('\n').map((line) => <p class="ref__quote">{line}</p>)}
                      </div>
                    )}
                    {r.note && <p class="ref__note">{r.note}</p>}
                    {r.source && (
                      <a class="ref__source" href={r.source} target="_blank" rel="noopener noreferrer">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                          <path
                            d="M4 11L12 4l8 7M6 10v9h12v-9"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        {strings.viewFullArticle}
                      </a>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </div>
        </details>
      ))
    }
  </div>
</details>
