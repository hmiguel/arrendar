---
import Timeline from '../components/Timeline.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Guia do Arrendamento Habitacional</title>
    <meta
      name="description"
      content="O essencial da lei do arrendamento habitacional em Portugal, explicado em português simples, com detalhe legal para quem quiser aprofundar."
    />
    <link rel="canonical" href="https://arrendar.hmiguel.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://arrendar.hmiguel.dev/" />
    <meta property="og:title" content="Guia do Arrendamento Habitacional" />
    <meta
      property="og:description"
      content="O essencial da lei do arrendamento habitacional em Portugal, explicado em português simples, com detalhe legal para quem quiser aprofundar."
    />
    <meta property="og:locale" content="pt_PT" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#fafaf8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Guia do Arrendamento Habitacional',
      description:
        'O essencial da lei do arrendamento habitacional em Portugal, explicado em português simples, com detalhe legal para quem quiser aprofundar.',
      url: 'https://arrendar.hmiguel.dev/',
      inLanguage: 'pt-PT',
      about: [
        { '@type': 'Legislation', name: 'Lei n.º 6/2006 (Novo Regime do Arrendamento Urbano)' },
        { '@type': 'Legislation', name: 'Lei n.º 56/2023 (Mais Habitação)' },
      ],
    })} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>
    <div class="page">
      <header class="hero">
        <span class="hero__eyebrow">Guia do arrendamento habitacional</span>
        <span class="hero__bar" aria-hidden="true"></span>
        <h1 class="hero__title">O que diz a lei portuguesa sobre arrendar casa, em português simples.</h1>
      </header>

      <div class="notice">
        <span class="notice__label">Em discussão</span>
        <p>
          Em julho de 2026, o Governo aprovou em Conselho de Ministros uma proposta para mudar esta lei,
          mas ainda tem de passar pelo Parlamento. Pode alterar a <strong>caução</strong>, os
          <strong>prazos de denúncia</strong> e a <strong>atualização de rendas antigas</strong>. Esta
          página mostra a lei atualmente em vigor e assinala, em cada ponto, o que pode vir a mudar.
        </p>
      </div>

      <main id="conteudo">
        <Timeline />
      </main>

      <footer class="colophon">
        <p>
          <strong>Isto não é aconselhamento jurídico.</strong> Em caso de dúvida sobre o seu contrato,
          consulte um advogado ou o Balcão do Arrendatário e do Senhorio (BAS).
        </p>
        <p>
          Fontes: Código Civil (Arts. 1069.º–1113.º), Lei n.º 6/2006 (Novo Regime do Arrendamento Urbano),
          Lei n.º 56/2023 (Mais Habitação).
        </p>
        <p class="colophon__meta">Última revisão · outubro de 2026</p>
        <a class="colophon__github" href="https://github.com/hmiguel/arrendar" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            />
          </svg>
          Código aberto no GitHub
        </a>
      </footer>
    </div>
  </body>
</html>
